rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is staff
    function isStaff() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'doctor', 'staff', 'receptionist'];
    }
    
    // Function to check if user is admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. Inventory & Records: Only Doctors/Staff and Admin
    match /inventory/{item} {
      allow read: if isStaff();
      allow write: if isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['doctor', 'staff'];
    }

    // 2. Appointments: Receptionists and Admins
    match /appointments/{appointment} {
      allow read: if isStaff();
      allow write: if isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'receptionist' || request.auth != null;
    }

    // 3. Activity Log: Admins Only
    match /activity_log/{log} {
      allow read, write: if isAdmin();
    }

    // 4. Staff Management: Admins Only
    match /users/{userId} {
      allow read: if isStaff() || request.auth.uid == userId;
      allow write: if isAdmin();
    }
  }
}
